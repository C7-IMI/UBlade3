+    OUTPUT_NAME ublade3_native_v6
+    LIBRARY_OUTPUT_DIRECTORY "${HYPERX_OUT}"
+    RUNTIME_OUTPUT_DIRECTORY "${HYPERX_OUT}")
+target_link_libraries(ublade3_native PRIVATE SDL3::SDL3 miniaudio imgui adlib)
+target_link_libraries(ublade3_native PRIVATE hyperx_options hyperx_permissive)
+hyperx_copy_runtime_dlls(ublade3_native "${HYPERX_OUT}")
+
+
 if(WIN32)
     set_target_properties(hyperx PROPERTIES WIN32_EXECUTABLE ON)
     target_sources(hyperx PRIVATE res/hyperblade_20XX.rc)
