{
  "schema": "gypsy.capability/v1",
  "id": "engine.unity.ublade3.build",
  "layer": "engine",
  "engine": "unity",
  "kind": "build",
  "maturity": "stable",
  "description": "Unity 6000.6.7f1 batchmode Windows build of the UBlade3 host, verified on this machine.",
  "requires": [
    "unity.installed",
    "unity.licence",
    "unity.windows.standalone"
  ],
  "inputs": [
    {
      "name": "project",
      "type": "path"
    },
    {
      "name": "target",
      "type": "string"
    }
  ],
  "outputs": [
