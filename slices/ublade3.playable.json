{
  "schema": "gypsy.slice/v1",
  "id": "ublade3.playable",
  "project": ".",
  "description": "UBlade3: exact data/sim/asset checks, native Unity player build, embedded-engine match capture, release and repository checks.",
  "artifacts": [
    "artifacts/ublade3/checks.log",
    "unity/UBlade3/build-native/UBlade3Native.exe",
    "artifacts/native-release-match.png",
    "dist/UBlade3-2026.10.31.002-win64.zip",
    "artifacts/ublade3-release.json"
  ],
  "steps": [
    {
      "id": "toolpack",
      "kind": "toolpack",
      "needs": [],
      "required": true,
      "timeout": 2400,
      "args": {
        "toolpack": "ublade3.unity",
        "path": "toolpacks/ublade3.unity.json"
      }
    },
    {
      "id": "checks",
      "kind": "check_all",
      "needs": [
        "toolpack"
      ],
      "required": true,
      "timeout": 180,
      "args": {}
    }
  ]
}
