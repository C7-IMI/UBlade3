{
  "schema": "gypsy.toolpack/v1",
  "id": "ublade3.unity",
  "name": "UBlade3 Unity 6000.6.7f1 exact-port host",
  "tools": [
    "Unity 6000.6.7f1",
    "Windows Standalone Build Support",
    "Embedded ublade3_native exact engine (LGPL-3.0)",
    "Original HyperBlade data (user supplied)"
  ],
  "license": "UBlade3 code and embedded decompilation: LGPL-3.0. Original game data is proprietary and never committed.",
  "actions": [
    {
      "id": "checks",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ublade3_unity.ps1",
        "-Mode",
        "checks"
      ],
      "cwd": ".",
      "timeout": 900,
      "artifacts": [
        "artifacts/ublade3/checks.log"
      ],
      "args": {
        "note": "Unity batchmode data probe + exact sim self-check"
      }
    },
    {
      "id": "build",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ublade3_unity.ps1",
        "-Mode",
        "build"
      ],
      "cwd": ".",
      "timeout": 1800,
      "artifacts": [
        "unity/UBlade3/build/UBlade3.exe",
        "artifacts/ublade3/unity.log"
      ],
      "args": {
        "note": "Unity batchmode Windows player build"
      }
    },
    {
      "id": "native-build",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ublade3_native.ps1",
        "-Mode",
        "build"
      ],
      "cwd": ".",
      "timeout": 1800,
      "artifacts": [
        "unity/UBlade3/build-native/UBlade3Native.exe"
      ],
      "args": {
        "note": "Build the native Unity player hosting the embedded exact engine"
      }
    },
    {
      "id": "native-capture",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ublade3_native.ps1",
        "-Mode",
        "capture"
      ],
      "cwd": ".",
      "timeout": 600,
      "artifacts": [
        "artifacts/native-release-match.png"
      ],
      "args": {
        "note": "Launch the native player, navigate to an exact match and capture the HUD frame"
      }
    },
    {
      "id": "capture",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ublade3_unity.ps1",
        "-Mode",
        "capture"
      ],
      "cwd": ".",
      "timeout": 300,
      "artifacts": [
        "artifacts/port-lab.png",
        "artifacts/ublade3/player.log"
      ],
      "args": {
        "note": "Port Lab capture with data/sim status"
      }
    },
    {
      "id": "release",
      "argv": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ublade3_release.ps1"
      ],
      "cwd": ".",
      "timeout": 600,
      "artifacts": [
        "dist/UBlade3-2026.10.31.002-win64.zip",
        "artifacts/ublade3-release.json"
      ],
      "args": {
        "note": "Package the native Unity player with the embedded exact engine; original data never included"
      }
    }
  ],
  "validators": [
    {
      "id": "checks-ok",
      "kind": "text",
      "artifact": "artifacts/ublade3/checks.log",
      "contains": "UBLADE3_CHECKS_OK"
    },
    {
      "id": "exe",
      "kind": "file",
      "artifact": "unity/UBlade3/build/UBlade3.exe",
      "minBytes": 500000
    },
    {
      "id": "build-ok",
      "kind": "text",
      "artifact": "artifacts/ublade3/unity.log",
      "contains": "UBLADE3_BUILD_OK"
    },
    {
      "id": "capture-frame",
      "kind": "file",
      "artifact": "artifacts/port-lab.png",
      "minBytes": 10000
    },
    {
      "id": "release-zip",
      "kind": "file",
      "artifact": "dist/UBlade3-2026.10.31.002-win64.zip",
      "minBytes": 1000000
    },
    {
      "id": "native-capture-frame",
      "kind": "file",
      "artifact": "artifacts/native-release-match.png",
      "minBytes": 10000
    }
  ]
}
